                <mxCell id="0_0V6qsEWYtUXTMsCOMM-9" value="&lt;pre style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0px; tab-size: 4; white-space: pre-wrap; background-color: rgb(246, 248, 250); padding: 8px 0px 10px;&quot;&gt;&lt;code class=&quot;language-Python&quot;&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: rgb(130, 80, 223);&quot;&gt;write_dataset_assessment&lt;/span&gt;(&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;*&lt;/span&gt;,&lt;br&gt;    assessment: &lt;span style=&quot;background-color: rgb(255, 204, 230);&quot;&gt;DatasetAssessment&lt;/span&gt;,&lt;br&gt;    input_fingerprints: &lt;span style=&quot;background-color: rgb(255, 204, 230);&quot;&gt;DatasetInputFingerprints&lt;/span&gt;,&lt;br&gt;    output_dir: str &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/span&gt; Path,&lt;br&gt;) -&amp;gt; &lt;span style=&quot;background-color: rgb(255, 204, 230);&quot;&gt;DatasetAssessmentArtifacts&lt;/span&gt;:&lt;br&gt;&lt;br&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;    def write_dataframe(...):&lt;br/&gt;        ...&lt;br/&gt;&lt;br/&gt;    def write_issues(...):&lt;br/&gt;        ...&lt;br/&gt;&lt;br/&gt;    def build_manifest(...):&lt;br/&gt;        ...&lt;br/&gt;&lt;br/&gt;    def write_manifest(...):&lt;br/&gt;        ...&lt;/code&gt;&lt;/pre&gt;&lt;br&gt;    output_path &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;background-color: rgb(255, 255, 204);&quot;&gt;validate_new_output_directory&lt;/span&gt;(output_dir)&lt;br&gt;    assessment_id &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;background-color: rgb(255, 255, 204);&quot;&gt;create_assessment_id&lt;/span&gt;()&lt;br&gt;    created_at_utc &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt