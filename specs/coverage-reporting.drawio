    <diagram id="n9PP8s4IWfnkzhacQgZd" name="Overall flow for src">
        <mxGraphModel dx="2058" dy="3012" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="1KTzcqApBuuX-6gcf4-w-2" value="&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;class DatasetAssessmentRun(TypedDict):&lt;br/&gt;    assessment: DatasetAssessment&lt;br/&gt;    artifacts: DatasetAssessmentArtifacts&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;def run_dataset_assessment(&lt;br/&gt;    *,&lt;br/&gt;    kindex_path: str | Path,&lt;br/&gt;    omni_path: str | Path,&lt;br/&gt;    location: str,&lt;br/&gt;    start_utc: str | datetime | pd.Timestamp,&lt;br/&gt;    end_utc: str | datetime | pd.Timestamp,&lt;br/&gt;    omni_parameters: list[str],&lt;br/&gt;    omni_lookback_minutes: int,&lt;br/&gt;    kindex_lag_count: int,&lt;br/&gt;    output_dir: str | Path,&lt;br/&gt;    display_detail: Literal[&quot;summary&quot;, &quot;issues&quot;, &quot;full&quot;],&lt;br/&gt;    logger: logging.Logger,&lt;br/&gt;) -&amp;gt; DatasetAssessmentRun:&lt;br/&gt;    &quot;&quot;&quot;Assess, persist, and print one modelling-dataset request.&quot;&quot;&quot;&lt;br/&gt;&lt;br/&gt;    logger.info(&lt;br/&gt;        &quot;Starting dataset assessment | &quot;&lt;br/&gt;        &quot;location=%s | interval=[%s, %s) | &quot;&lt;br/&gt;        &quot;omni_parameters=%s | omni_lookback_minutes=%d | &quot;&lt;br/&gt;        &quot;kindex_lag_count=%d&quot;,&lt;br/&gt;        location,&lt;br/&gt;        start_utc,&lt;br/&gt;        end_utc,&lt;br/&gt;        omni_parameters,&lt;br/&gt;        omni_lookback_minutes,&lt;br/&gt;        kindex_lag_count,&lt;br/&gt;    )&lt;br/&gt;&lt;br/&gt;    # 1. Perform all coverage calculations and eligibility evaluation.&lt;br/&gt;    # This function does not print or write anything.&lt;br/&gt;    assessment = assess_dataset_request(&lt;br/&gt;        kindex_path=kindex_path,&lt;br/&gt;        omni_path=omni_path,&lt;br/&gt;        location=location,&lt;br/&gt;        start_utc=start_utc,&lt;br/&gt;        end_utc=end_utc,&lt;br/&gt;        omni_parameters=omni_parameters,&lt;br/&gt;        omni_lookback_minutes=omni_lookback_minutes,&lt;br/&gt;        kindex_lag_count=kindex_lag_count,&lt;br/&gt;    )&lt;br/&gt;&lt;br/&gt;    logger.info(&lt;br/&gt;        &quot;Dataset assessment complete | is_ready=%s | issues=%d&quot;,&lt;br/&gt;        assessment[&quot;is_ready&quot;],&lt;br/&gt;        len(assessment[&quot;issues&quot;]),&lt;br/&gt;    )&lt;br/&gt;&lt;br/&gt;    # 2. Persist the completed assessment and its manifest.&lt;br/&gt;    # A blocked assessment is still a successful assessment artifact.&lt;br/&gt;    artifacts = write_dataset_assessment(&lt;br/&gt;        assessment=assessment,&lt;br/&gt;        output_dir=output_dir,&lt;br/&gt;    )&lt;br/&gt;&lt;br/&gt;    logger.info(&lt;br/&gt;        &quot;Dataset assessment saved | manifest=%s&quot;,&lt;br/&gt;        artifacts[&quot;manifest_path&quot;],&lt;br/&gt;    )&lt;br/&gt;&lt;br/&gt;    # 3. Present the successfully persisted result.&lt;br/&gt;    print_dataset_assessment(&lt;br/&gt;        assessment=assessment,&lt;br/&gt;        detail=display_detail,&lt;br/&gt;    )&lt;br/&gt;&lt;br/&gt;    # Return both the in-memory result and paths to persisted artifacts.&lt;br/&gt;    return {&lt;br/&gt;        &quot;assessment&quot;: assessment,&lt;br/&gt;        &quot;artifacts&quot;: artifacts,&lt;br/&gt;    }&lt;/code&gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="-914" y="-1418" width="542" height="1224" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
