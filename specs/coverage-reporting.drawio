                <mxCell id="gWd4IwDMt4Clc4eWDpV_-8" value="3. read canonical kindex rows,&lt;div&gt;filter only for requested locations&lt;/div&gt;&lt;div&gt;and times&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;code dir=&quot;ltr&quot;&gt;valid_time&lt;/code&gt;&lt;/th&gt;&lt;th&gt;&lt;code dir=&quot;ltr&quot;&gt;kindex&lt;/code&gt;&lt;/th&gt;&lt;th&gt;&lt;code dir=&quot;ltr&quot;&gt;flag&lt;/code&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;2026-01-01 03:00&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;false&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2026-01-01 06:00&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;true&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2026-01-01 12:00&lt;/td&gt;&lt;td&gt;null&lt;/td&gt;&lt;td&gt;false&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2026-01-01 15:00&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;false&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
