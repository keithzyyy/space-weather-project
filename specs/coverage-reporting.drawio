                <mxCell id="0_0V6qsEWYtUXTMsCOMM-13" value="&lt;pre style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0px; tab-size: 4; white-space: pre-wrap; background-color: rgb(246, 248, 250); padding: 8px 0px 10px;&quot;&gt;&lt;code class=&quot;language-Python&quot;&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: rgb(130, 80, 223);&quot;&gt;assess_dataset_request&lt;/span&gt;(&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;*&lt;/span&gt;,&lt;br&gt;    kindex_path: str &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/span&gt; Path,&lt;br&gt;    omni_path: str &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/span&gt; Path,&lt;br&gt;    location: str,&lt;br&gt;    start_utc: str &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/span&gt; datetime &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/span&gt; pd&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;Timestamp&lt;/span&gt;,&lt;br&gt;    end_utc: str &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/span&gt; datetime &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/span&gt; pd&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;Timestamp&lt;/span&gt;,&lt;br&gt;    omni_parameters: list[str],&lt;br&gt;    omni_lookback_minutes: int,&lt;br&gt;    kindex_lag_count: int,&lt;br&gt;) -&amp;gt; &lt;span style=&quot;background-color: rgb(255, 204, 230);&quot;&gt;DatasetAssessment&lt;/span&gt;:&lt;br&gt;    &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;&quot;&quot;Assess canonical coverage for one modelling-dataset request.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;    This function performs calculation only. It does not print, log, or write &lt;/span&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;assessment artifacts.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;    &quot;&quot;&quot;&lt;/span&gt;&lt;br&gt;    &lt;span style=&quot;color: rgb(106, 115, 125); font-style: italic;&quot;&gt;# 1. Validate and normalize the complete request once.&lt;/span&gt;&lt;br&gt;    request &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; validate_dataset_request(&lt;br&gt;        kindex_path&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;kindex_path,&lt;br&gt;        omni_path&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;omni_path,&lt;br&gt;        location&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;location,&lt;br&gt;        start_utc&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;start_utc,&lt;br&gt;        end_utc&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;end_utc,&lt;br&gt;        omni_parameters&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;omni_parameters,&lt;br&gt;        omni_lookback_minutes&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;omni_lookback_minutes,&lt;br&gt;        kindex_lag_count&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;kindex_lag_count,&lt;br&gt;    )&lt;br&gt;    }&lt;br&gt;    # [start_utc, end_utc).&lt;br&gt;    sample_plan = build_sample_plan(&lt;br&gt;        start_utc=request[&quot;start_utc&quot;],&lt;br&gt;        end_utc=request[&quot;end_utc&quot;],&lt;br&gt;    )&lt;br&gt;    # 3. Targets and consecutive K-index lags form one continuous interval.&lt;br&gt;    kindex_coverage_start = (&lt;br&gt;        request[&quot;start_utc&quot;]&lt;br&gt;        - request[&quot;kindex_lag_count&quot;] * pd.Timedelta(hours=3)&lt;br&gt;    )&lt;br&gt;    kindex_report = kindex_coverage_report(&lt;br&gt;        kindex_path=request[&quot;kindex_path&quot;],&lt;br&gt;        location=request[&quot;location&quot;],&lt;br&gt;        start_utc=kindex_coverage_start,&lt;br&gt;        end_utc=request[&quot;end_utc&quot;],&lt;br&gt;    )&lt;br&gt;    # 4. Run OMNI coverage once for each forecast origin. Enrich every per-parameter summary with its explicit lookback-window context.&lt;br&gt;&lt;br&gt;    omni_summary_frames: list[pd.DataFrame] = []&lt;br&gt;    for target in sample_plan.itertuples(index=False):&lt;br&gt;        forecast_origin = target.forecast_origin&lt;br&gt;        omni_window_end = forecast_origin&lt;br&gt;        omni_window_start = (&lt;br&gt;            forecast_origin&lt;br&gt;            - pd.Timedelta(&lt;br&gt;                minutes=request[&quot;omni_lookback_minutes&quot;]&lt;br&gt;            )&lt;br&gt;        )&lt;br&gt;        omni_report = omni_coverage_report(&lt;br&gt;            omni_path=request[&quot;omni_path&quot;],&lt;br&gt;            parameters=request[&quot;omni_parameters&quot;],&lt;br&gt;            target_utc=forecast_origin,&lt;br&gt;            lookback_minutes=request[&quot;omni_lookback_minutes&quot;],&lt;br&gt;        )&lt;br&gt;        # Copy before adding orchestrator-owned columns so the standalone OmniCoverageReport remains unchanged.&lt;br&gt;        window_summary = omni_report[&quot;summary&quot;].copy()&lt;br&gt;        # Repeated insert(0, ...) calls put the final columns in the desired&lt;br&gt;        # left-to-right order.&lt;br&gt;        window_summary.insert(&lt;br&gt;            0,&lt;br&gt;            &quot;forecast_origin&quot;,&lt;br&gt;            forecast_origin,&lt;br&gt;        )&lt;br&gt;        window_summary.insert(&lt;br&gt;            0,&lt;br&gt;            &quot;omni_window_end_utc_exclusive&quot;,&lt;br&gt;            omni_window_end,&lt;br&gt;        )&lt;br&gt;        window_summary.insert(&lt;br&gt;            0,&lt;br&gt;            &quot;omni_window_start_utc&quot;,&lt;br&gt;            omni_window_start,&lt;br&gt;        )&lt;br&gt;        omni_summary_frames.append(window_summary)&lt;br&gt;    # Request validation guarantees at least one three-hour sample, so this&lt;br&gt;    # concatenation receives at least one summary DataFrame.&lt;br&gt;    omni_summary = pd.concat(&lt;br&gt;        omni_summary_frames,&lt;br&gt;        ignore_index=True,&lt;br&gt;    )&lt;br&gt;    # 5. Apply the cross-dataset eligibility policy to the completed reports.&lt;br&gt;    issues = evaluate_dataset_eligibility(&lt;br&gt;        kindex_report=kindex_report,&lt;br&gt;        omni_summary=omni_summary,&lt;br&gt;    )&lt;br&gt;    return {&lt;br&gt;        &quot;request&quot;: request,&lt;br&gt;        &quot;sample_plan&quot;: sample_plan,&lt;br&gt;        &quot;kindex_report&quot;: kindex_report,&lt;br&gt;        &quot;omni_summary&quot;: omni_summary,&lt;br&gt;        &quot;issues&quot;: issues,&lt;br&gt;        &quot;is_ready&quot;: len(issues) == 0,&lt;br&gt;    }&lt;/code&gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="77" y="531" width="901" height="1915" as="geometry"/>
                </mxCell>
                <mxCell id="0_0V6qsEWYtUXTMsCOMM-3" value="&lt;pre style=&quot;display: block; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0px; tab-size: 4; white-space: pre-wrap; background-color: rgb(246, 248, 250); padding: 8px 0px 10px;&quot;&gt;&lt;code class=&quot;language-Python&quot;&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;class&lt;/span&gt; DatasetAssessment(TypedDict):&lt;br&gt;    request: DatasetRequest&lt;br&gt;    sample_plan: pd&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;DataFrame&lt;/span&gt;&lt;br&gt;    kindex_report: &lt;span style=&quot;background-color: rgb(255, 204, 230);&quot;&gt;KIndexCoverageReport&lt;/span&gt;&lt;br&gt;    omni_summary: pd&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;DataFrame&lt;/span&gt;&lt;br&gt;    issues: list[&lt;span style=&quot;background-color: rgb(255, 204, 230);&quot;&gt;DatasetEligibilityIssue&lt;/span&gt;]&lt;br&gt;    is_ready: bool&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1">
                    <mxGeometry x="455" y="566" width="342" height="159" as="geometry"/>
                </mxCell>
                <mxCell id="_z0JOxSN1zZp124sYB1b-2" value="&lt;pre style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0px; tab-size: 4; white-space: pre-wrap; background-color: rgb(246, 248, 250); padding: 8px 0px 10px;&quot;&gt;&lt;code class=&quot;language-Python&quot;&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: rgb(130, 80, 223);&quot;&gt;fingerprint_assessment_inputs&lt;/span&gt;(&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;*&lt;/span&gt;,&lt;br&gt;    kindex_path: str &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/span&gt; Path,&lt;br&gt;    omni_path: str &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/span&gt; Path,&lt;br&gt;) -&amp;gt; &lt;span style=&quot;background-color: rgb(255, 204, 230);&quot;&gt;DatasetInputFingerprints&lt;/span&gt;:&lt;br&gt;    &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;&quot;&quot;Record inexpensive metadata fingerprints for canonical inputs.&quot;&quot;&quot;&lt;/span&gt;&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: rgb(130, 80, 223);&quot;&gt;fingerprint_table&lt;/span&gt;(&lt;br&gt;        canonical_path: str &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/span&gt; Path,&lt;br&gt;        argument_name: str,&lt;br&gt;    ) -&amp;gt; &lt;span style=&quot;background-color: rgb(255, 204, 230);&quot;&gt;CanonicalTableFingerprint&lt;/span&gt;:&lt;br&gt;        &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;not&lt;/span&gt; str(canonical_path)&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;strip&lt;/span&gt;():&lt;br&gt;            &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;raise&lt;/span&gt; ValueError(&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;f&quot;&lt;/span&gt;{argument_name}&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt; must not be blank&quot;&lt;/span&gt;)&lt;br&gt;        path &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; Path(canonical_path)&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;resolve&lt;/span&gt;(strict&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;True)&lt;br&gt;        &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;if&lt;/span&gt; path&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;is_file&lt;/span&gt;():&lt;br&gt;            parquet_files &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; [path]&lt;br&gt;            relative_to &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; path&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;parent&lt;/span&gt;&lt;br&gt;        &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;elif&lt;/span&gt; path&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;is_dir&lt;/span&gt;():&lt;br&gt;            parquet_files &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; sorted(&lt;br&gt;                candidate&lt;br&gt;                &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;for&lt;/span&gt; candidate &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;in&lt;/span&gt; path&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;rglob&lt;/span&gt;(&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;*.parquet&quot;&lt;/span&gt;)&lt;br&gt;                &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;if&lt;/span&gt; candidate&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;is_file&lt;/span&gt;()&lt;br&gt;            )&lt;br&gt;            relative_to &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; path&lt;br&gt;        &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;else&lt;/span&gt;:&lt;br&gt;            &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;raise&lt;/span&gt; ValueError(&lt;br&gt;                &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;f&quot;&lt;/span&gt;{argument_name}&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt; must identify a file or directory&quot;&lt;/span&gt;&lt;br&gt;            )&lt;br&gt;        &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;not&lt;/span&gt; parquet_files:&lt;br&gt;            &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;raise&lt;/span&gt; FileNotFoundError(&lt;br&gt;                &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;f&quot;No Parquet files found for &lt;/span&gt;{argument_name}&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;: &lt;/span&gt;{path}&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;&lt;/span&gt;&lt;br&gt;            )&lt;br&gt;        file_fingerprints: list[&lt;span style=&quot;background-color: rgb(255, 204, 230);&quot;&gt;CanonicalFileFingerprint&lt;/span&gt;] &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; []&lt;br&gt;        &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;for&lt;/span&gt; parquet_file &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;in&lt;/span&gt; parquet_files:&lt;br&gt;            metadata &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; parquet_file&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;stat&lt;/span&gt;()&lt;br&gt;            file_fingerprints&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;append&lt;/span&gt;(&lt;br&gt;                {&lt;br&gt;                    &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;relative_path&quot;&lt;/span&gt;: parquet_file&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;relative_to&lt;/span&gt;(&lt;br&gt;                        relative_to&lt;br&gt;                    )&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;as_posix&lt;/span&gt;(),&lt;br&gt;                    &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;size_bytes&quot;&lt;/span&gt;: metadata&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;st_size&lt;/span&gt;,&lt;br&gt;                    &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;modified_time_ns&quot;&lt;/span&gt;: metadata&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;st_mtime_ns&lt;/span&gt;,&lt;br&gt;                }&lt;br&gt;            )&lt;br&gt;        &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;return&lt;/span&gt; {&lt;br&gt;            &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;resolved_path&quot;&lt;/span&gt;: path&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;as_posix&lt;/span&gt;(),&lt;br&gt;            &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;files&quot;&lt;/span&gt;: file_fingerprints,&lt;br&gt;        }&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;return&lt;/span&gt; {&lt;br&gt;        &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;kindex&quot;&lt;/span&gt;: fingerprint_table(&lt;br&gt;            canonical_path&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;kindex_path,&lt;br&gt;            argument_name&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;kindex_path&quot;&lt;/span&gt;,&lt;br&gt;        ),&lt;br&gt;        &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;omni&quot;&lt;/span&gt;: fingerprint_table(&lt;br&gt;            canonical_path&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;omni_path,&lt;br&gt;            argument_name&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;omni_path&quot;&lt;/span&gt;,&lt;br&gt;        ),&lt;br&gt;    }&lt;/code&gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="-1898" y="-26" width="578" height="1241" as="geometry"/>
                </mxCell>
                <mxCell id="0_0V6qsEWYtUXTMsCOMM-2" value="&lt;pre style=&quot;display: block; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0px; tab-size: 4; white-space: pre-wrap; padding: 8px 0px 10px;&quot;&gt;&lt;code class=&quot;language-Python&quot;&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;class&lt;/span&gt; DatasetEligibilityIssue(TypedDict):&lt;br&gt;    dataset: str&lt;br&gt;    interval_start_utc: NotRequired[pd&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;Timestamp&lt;/span&gt;]&lt;br&gt;    interval_end_utc_exclusive: NotRequired[pd&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;Timestamp&lt;/span&gt;]&lt;br&gt;&lt;br&gt;    omni_window_start_utc: NotRequired[pd&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;Timestamp&lt;/span&gt;]&lt;br&gt;    omni_window_end_utc_exclusive: NotRequired[pd&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;Timestamp&lt;/span&gt;]&lt;br&gt;    forecast_origin: NotRequired[pd&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;Timestamp&lt;/span&gt;]&lt;br&gt;    parameter: NotRequired[str]&lt;br&gt;&lt;br&gt;    issue: str&lt;br&gt;    count: int&lt;br&gt;    blocks_construction: bool&lt;br&gt;    suggested_action: str&lt;br&gt;&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;labelBackgroundColor=#FFCCE6;" vertex="1" parent="1">
                    <mxGeometry x="464" y="2211" width="488" height="314" as="geometry"/>
                </mxCell>
                <mxCell id="_z0JOxSN1zZp124sYB1b-3" value="&lt;pre style=&quot;display: block; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0px; tab-size: 4; white-space: pre-wrap; background-color: rgb(246, 248, 250); padding: 8px 0px 10px;&quot;&gt;&lt;code class=&quot;language-Python&quot;&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;class&lt;/span&gt; CanonicalTableFingerprint(TypedDict):&lt;br&gt;    resolved_path: str&lt;br&gt;    files: list[CanonicalFileFingerprint]&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;class&lt;/span&gt; DatasetInputFingerprints(TypedDict):&lt;br&gt;    kindex: CanonicalTableFingerprint&lt;br&gt;    omni: CanonicalTableFingerprint&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1">
                    <mxGeometry x="-2266" y="118" width="359" height="211" as="geometry"/>
                </mxCell>
                <mxCell id="_z0JOxSN1zZp124sYB1b-4" value="&lt;pre style=&quot;display: block; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0px; tab-size: 4; white-space: pre-wrap; background-color: rgb(246, 248, 250); padding: 8px 0px 10px;&quot;&gt;&lt;code class=&quot;language-Python&quot;&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;class&lt;/span&gt; CanonicalFileFingerprint(TypedDict):&lt;br&gt;    relative_path: str&lt;br&gt;    size_bytes: int&lt;br&gt;    modified_time_ns: int&lt;br&gt;&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1">
                    <mxGeometry x="-2202" y="682" width="359" height="136" as="geometry"/>
                </mxCell>
                <mxCell id="_z0JOxSN1zZp124sYB1b-6" value="&lt;pre style=&quot;display: block; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0; tab-size: 4; white-space: pre-wrap; background-color: rgb(246, 248, 250); padding: 8px 0px 10px 0px&quot;&gt;&lt;code class=&quot;language-Python&quot;&gt;&lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;class&lt;/span&gt; DatasetAssessmentArtifacts(TypedDict):&lt;br&gt;    output_dir: Path&lt;br&gt;    manifest_path: Path&lt;br&gt;    artifact_paths: dict[str, Path]&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1">
                    <mxGeometry x="-314.9995483398437" y="1229.99958404541" width="367" height="116" as="geometry"/>
                </mxCell>
                <UserObject label="&lt;pre style=&quot;display: block; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0px; tab-size: 4; white-space: pre-wrap; background-color: rgb(246, 248, 250); padding: 8px 0px 10px;&quot;&gt;&lt;code class=&quot;language-Python&quot;&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;from&lt;/span&gt; typing &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;import&lt;/span&gt; Literal, TextIO&lt;br&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;import&lt;/span&gt; pandas &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;as&lt;/span&gt; pd&lt;br&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: rgb(130, 80, 223);&quot;&gt;print_dataset_assessment&lt;/span&gt;(&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;*&lt;/span&gt;,&lt;br&gt;    assessment: &lt;span style=&quot;background-color: rgb(255, 204, 230);&quot;&gt;DatasetAssessment&lt;/span&gt;,&lt;br&gt;    detail: Literal[&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;summary&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;issues&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;full&quot;&lt;/span&gt;] &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;summary&quot;&lt;/span&gt;,&lt;br&gt;    stream: TextIO &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;|&lt;/span&gt; &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;None&lt;/span&gt; &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;None&lt;/span&gt;,&lt;br&gt;) -&amp;gt; &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;None&lt;/span&gt;:&lt;br&gt;    &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;&quot;&quot;Print a human-readable dataset assessment.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;    Detail levels:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;    - ``summary`` prints the request, readiness, aggregate K-index and OMNI&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;      coverage, and an issue summary.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;    - ``issues`` additionally prints interval/window rows related to blocking&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;      issues.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;    - ``full`` prints every assessment table.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;    &quot;&quot;&quot;&lt;/span&gt;&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;if&lt;/span&gt; detail &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;not&lt;/span&gt; &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;in&lt;/span&gt; {&lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;summary&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;issues&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;full&quot;&lt;/span&gt;}:&lt;br&gt;        &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;raise&lt;/span&gt; ValueError(&lt;br&gt;            &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;detail must be &#39;summary&#39;, &#39;issues&#39;, or &#39;full&#39;&quot;&lt;/span&gt;&lt;br&gt;        )&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: rgb(130, 80, 223);&quot;&gt;emit&lt;/span&gt;(text: str &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;&quot;&lt;/span&gt;) -&amp;gt; &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;None&lt;/span&gt;:&lt;br&gt;&lt;br&gt;    def print_heading(title: str) -&amp;gt; None:&lt;br&gt;        emit()&lt;br&gt;        emit(title)&lt;br&gt;        emit(&quot;=&quot; * len(title))&lt;br&gt;    def print_frame(&lt;br&gt;        title: str,&lt;br&gt;        frame: pd.DataFrame,&lt;br&gt;    ) -&amp;gt; None:&lt;br&gt;        &quot;&quot;&quot;Print one DataFrame without exposing its pandas index.&quot;&quot;&quot;&lt;br&gt;        print_heading(title)&lt;br&gt;        if frame.empty:&lt;br&gt;            emit(&quot;(none)&quot;)&lt;br&gt;            return&lt;br&gt;        emit(&lt;br&gt;            frame.to_string(&lt;br&gt;                index=False,&lt;br&gt;                na_rep=&quot;NULL&quot;,&lt;br&gt;            )&lt;br&gt;        )&lt;br&gt;    request = assessment[&quot;request&quot;]&lt;br&gt;    sample_plan = assessment[&quot;sample_plan&quot;]&lt;br&gt;    kindex_report = assessment[&quot;kindex_report&quot;]&lt;br&gt;    omni_summary = assessment[&quot;omni_summary&quot;]&lt;br&gt;    issues = assessment[&quot;issues&quot;]&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 1. Overall request and result&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    emit(&quot;DATASET ASSESSMENT&quot;)&lt;br&gt;    emit(&quot;==================&quot;)&lt;br&gt;    emit(f&quot;Ready:                 {assessment[&#39;is_ready&#39;]}&quot;)&lt;br&gt;    emit(f&quot;Issue records:         {len(issues)}&quot;)&lt;br&gt;    emit(f&quot;Location:              {request[&#39;location&#39;]}&quot;)&lt;br&gt;    emit(&lt;br&gt;        &quot;Target interval:       &quot;&lt;br&gt;        f&quot;[{request[&#39;start_utc&#39;]}, {request[&#39;end_utc&#39;]})&quot;&lt;br&gt;    )&lt;br&gt;    emit(&lt;br&gt;        &quot;K-index lag count:     &quot;&lt;br&gt;        f&quot;{request[&#39;kindex_lag_count&#39;]}&quot;&lt;br&gt;    )&lt;br&gt;    emit(&lt;br&gt;        &quot;OMNI lookback minutes: &quot;&lt;br&gt;        f&quot;{request[&#39;omni_lookback_minutes&#39;]}&quot;&lt;br&gt;    )&lt;br&gt;    emit(&lt;br&gt;        &quot;OMNI parameters:       &quot;&lt;br&gt;        + &quot;, &quot;.join(request[&quot;omni_parameters&quot;])&lt;br&gt;    )&lt;br&gt;    emit(f&quot;Planned samples:       {len(sample_plan)}&quot;)&lt;br&gt;    emit(f&quot;K-index input:         {request[&#39;kindex_path&#39;]}&quot;)&lt;br&gt;    emit(f&quot;OMNI input:            {request[&#39;omni_path&#39;]}&quot;)&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 2. K-index summary&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    print_frame(&lt;br&gt;        &quot;K-INDEX COVERAGE SUMMARY&quot;,&lt;br&gt;        kindex_report[&quot;summary&quot;],&lt;br&gt;    )&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 3. OMNI request-level overview&lt;br&gt;    #&lt;br&gt;    # These are requirement counts across forecast-origin/parameter&lt;br&gt;    # combinations. Overlapping lookback windows can represent the same&lt;br&gt;    # physical source minute more than once.&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    omni_overview = pd.DataFrame(&lt;br&gt;        [&lt;br&gt;            {&lt;br&gt;                &quot;forecast_origin_count&quot;: (&lt;br&gt;                    omni_summary[&quot;forecast_origin&quot;].nunique()&lt;br&gt;                ),&lt;br&gt;                &quot;parameter_count&quot;: (&lt;br&gt;                    omni_summary[&quot;parameter&quot;].nunique()&lt;br&gt;                ),&lt;br&gt;                &quot;parameter_window_count&quot;: len(omni_summary),&lt;br&gt;                &quot;expected_requirement_minutes&quot;: int(&lt;br&gt;                    omni_summary[&quot;expected_minute_count&quot;].sum()&lt;br&gt;                ),&lt;br&gt;                &quot;absent_requirement_minutes&quot;: int(&lt;br&gt;                    omni_summary[&quot;absent_minute_count&quot;].sum()&lt;br&gt;                ),&lt;br&gt;                &quot;source_fill_requirement_minutes&quot;: int(&lt;br&gt;                    omni_summary[&quot;source_fill_minute_count&quot;].sum()&lt;br&gt;                ),&lt;br&gt;                &quot;unexplained_null_requirement_minutes&quot;: int(&lt;br&gt;                    omni_summary[&lt;br&gt;                        &quot;unexplained_null_minute_count&quot;&lt;br&gt;                    ].sum()&lt;br&gt;                ),&lt;br&gt;                &quot;conflict_requirement_minutes&quot;: int(&lt;br&gt;                    omni_summary[&quot;conflict_minute_count&quot;].sum()&lt;br&gt;                ),&lt;br&gt;                &quot;reingestion_candidate_windows&quot;: int(&lt;br&gt;                    omni_summary[&lt;br&gt;                        &quot;is_reingestion_candidate&quot;&lt;br&gt;                    ].sum()&lt;br&gt;                ),&lt;br&gt;            }&lt;br&gt;        ]&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;OMNI COVERAGE OVERVIEW&quot;,&lt;br&gt;        omni_overview,&lt;br&gt;    )&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 4. Issue summary&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    issues_frame = pd.DataFrame(issues)&lt;br&gt;    if issues_frame.empty:&lt;br&gt;        issue_summary = pd.DataFrame()&lt;br&gt;    else:&lt;br&gt;        issue_summary = (&lt;br&gt;            issues_frame&lt;br&gt;            .groupby(&lt;br&gt;                [&quot;dataset&quot;, &quot;issue&quot;],&lt;br&gt;                dropna=False,&lt;br&gt;                as_index=False,&lt;br&gt;            )&lt;br&gt;            .agg(&lt;br&gt;                issue_record_count=(&quot;count&quot;, &quot;size&quot;),&lt;br&gt;                reported_count_total=(&quot;count&quot;, &quot;sum&quot;),&lt;br&gt;            )&lt;br&gt;        )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;ELIGIBILITY ISSUE SUMMARY&quot;,&lt;br&gt;        issue_summary,&lt;br&gt;    )&lt;br&gt;    if detail == &quot;summary&quot;:&lt;br&gt;        return&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 5. Issue-focused output&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    if detail == &quot;issues&quot;:&lt;br&gt;        print_frame(&lt;br&gt;            &quot;K-INDEX GAP INTERVALS&quot;,&lt;br&gt;            kindex_report[&quot;gap_intervals&quot;],&lt;br&gt;        )&lt;br&gt;        print_frame(&lt;br&gt;            &quot;K-INDEX CONFLICT INTERVALS&quot;,&lt;br&gt;            kindex_report[&quot;conflict_intervals&quot;],&lt;br&gt;        )&lt;br&gt;        problematic_omni = omni_summary.loc[&lt;br&gt;            (&lt;br&gt;                omni_summary[&quot;is_reingestion_candidate&quot;]&lt;br&gt;            )&lt;br&gt;            | (&lt;br&gt;                omni_summary[&lt;br&gt;                    &quot;unexplained_null_minute_count&quot;&lt;br&gt;                ] &amp;gt; 0&lt;br&gt;            )&lt;br&gt;            | (&lt;br&gt;                omni_summary[&quot;conflict_minute_count&quot;] &amp;gt; 0&lt;br&gt;            )&lt;br&gt;        ]&lt;br&gt;        print_frame(&lt;br&gt;            &quot;OMNI PROBLEMATIC PARAMETER WINDOWS&quot;,&lt;br&gt;            problematic_omni,&lt;br&gt;        )&lt;br&gt;        print_frame(&lt;br&gt;            &quot;ELIGIBILITY ISSUE RECORDS&quot;,&lt;br&gt;            _ordered_issue_columns(issues_frame),&lt;br&gt;        )&lt;br&gt;        return&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 6. Complete output&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    print_frame(&lt;br&gt;        &quot;SAMPLE PLAN&quot;,&lt;br&gt;        sample_plan,&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;K-INDEX COVERED INTERVALS&quot;,&lt;br&gt;        kindex_report[&quot;covered_intervals&quot;],&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;K-INDEX GAP INTERVALS&quot;,&lt;br&gt;        kindex_report[&quot;gap_intervals&quot;],&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;K-INDEX CONFLICT INTERVALS&quot;,&lt;br&gt;        kindex_report[&quot;conflict_intervals&quot;],&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;OMNI COVERAGE BY FORECAST ORIGIN AND PARAMETER&quot;,&lt;br&gt;        omni_summary,&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;ELIGIBILITY ISSUE RECORDS&quot;,&lt;br&gt;        _ordered_issue_columns(issues_frame),&lt;br&gt;    )&lt;/code&gt;&lt;/pre&gt;" link="&lt;pre style=&quot;display: block; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0; tab-size: 4; white-space: pre-wrap; background-color: rgb(246, 248, 250); padding: 8px 0px 10px 0px&quot;&gt;&lt;code class=&quot;language-Python&quot;&gt;&lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;from&lt;/span&gt; typing &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;import&lt;/span&gt; Literal, TextIO&lt;br&gt;&lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;import&lt;/span&gt; pandas &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;as&lt;/span&gt; pd&lt;br&gt;&lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: rgb(130, 80, 223)&quot;&gt;print_dataset_assessment&lt;/span&gt;(&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;*&lt;/span&gt;,&lt;br&gt;    assessment: DatasetAssessment,&lt;br&gt;    detail: Literal[&lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;&quot;summary&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;&quot;issues&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;&quot;full&quot;&lt;/span&gt;] &lt;span style=&quot;color: rgb(204, 204, 204)&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;&quot;summary&quot;&lt;/span&gt;,&lt;br&gt;    stream: TextIO &lt;span style=&quot;color: rgb(204, 204, 204)&quot;&gt;|&lt;/span&gt; &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;None&lt;/span&gt; &lt;span style=&quot;color: rgb(204, 204, 204)&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;None&lt;/span&gt;,&lt;br&gt;) -&amp;gt; &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;None&lt;/span&gt;:&lt;br&gt;    &lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;&quot;&quot;&quot;Print a human-readable dataset assessment.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;    Detail levels:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;    - ``summary`` prints the request, readiness, aggregate K-index and OMNI&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;      coverage, and an issue summary.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;    - ``issues`` additionally prints interval/window rows related to blocking&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;      issues.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;    - ``full`` prints every assessment table.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;    &quot;&quot;&quot;&lt;/span&gt;&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;if&lt;/span&gt; detail &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;not&lt;/span&gt; &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;in&lt;/span&gt; {&lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;&quot;summary&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;&quot;issues&quot;&lt;/span&gt;, &lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;&quot;full&quot;&lt;/span&gt;}:&lt;br&gt;        &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;raise&lt;/span&gt; ValueError(&lt;br&gt;            &lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;&quot;detail must be &#39;summary&#39;, &#39;issues&#39;, or &#39;full&#39;&quot;&lt;/span&gt;&lt;br&gt;        )&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: rgb(130, 80, 223)&quot;&gt;emit&lt;/span&gt;(text: str &lt;span style=&quot;color: rgb(204, 204, 204)&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: rgb(10, 48, 105)&quot;&gt;&quot;&quot;&lt;/span&gt;) -&amp;gt; &lt;span style=&quot;color: rgb(207, 34, 46)&quot;&gt;None&lt;/span&gt;:&lt;br&gt;&lt;br&gt;    def print_heading(title: str) -&amp;gt; None:&lt;br&gt;        emit()&lt;br&gt;        emit(title)&lt;br&gt;        emit(&quot;=&quot; * len(title))&lt;br&gt;    def print_frame(&lt;br&gt;        title: str,&lt;br&gt;        frame: pd.DataFrame,&lt;br&gt;    ) -&amp;gt; None:&lt;br&gt;        &quot;&quot;&quot;Print one DataFrame without exposing its pandas index.&quot;&quot;&quot;&lt;br&gt;        print_heading(title)&lt;br&gt;        if frame.empty:&lt;br&gt;            emit(&quot;(none)&quot;)&lt;br&gt;            return&lt;br&gt;        emit(&lt;br&gt;            frame.to_string(&lt;br&gt;                index=False,&lt;br&gt;                na_rep=&quot;NULL&quot;,&lt;br&gt;            )&lt;br&gt;        )&lt;br&gt;    request = assessment[&quot;request&quot;]&lt;br&gt;    sample_plan = assessment[&quot;sample_plan&quot;]&lt;br&gt;    kindex_report = assessment[&quot;kindex_report&quot;]&lt;br&gt;    omni_summary = assessment[&quot;omni_summary&quot;]&lt;br&gt;    issues = assessment[&quot;issues&quot;]&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 1. Overall request and result&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    emit(&quot;DATASET ASSESSMENT&quot;)&lt;br&gt;    emit(&quot;==================&quot;)&lt;br&gt;    emit(f&quot;Ready:                 {assessment[&#39;is_ready&#39;]}&quot;)&lt;br&gt;    emit(f&quot;Issue records:         {len(issues)}&quot;)&lt;br&gt;    emit(f&quot;Location:              {request[&#39;location&#39;]}&quot;)&lt;br&gt;    emit(&lt;br&gt;        &quot;Target interval:       &quot;&lt;br&gt;        f&quot;[{request[&#39;start_utc&#39;]}, {request[&#39;end_utc&#39;]})&quot;&lt;br&gt;    )&lt;br&gt;    emit(&lt;br&gt;        &quot;K-index lag count:     &quot;&lt;br&gt;        f&quot;{request[&#39;kindex_lag_count&#39;]}&quot;&lt;br&gt;    )&lt;br&gt;    emit(&lt;br&gt;        &quot;OMNI lookback minutes: &quot;&lt;br&gt;        f&quot;{request[&#39;omni_lookback_minutes&#39;]}&quot;&lt;br&gt;    )&lt;br&gt;    emit(&lt;br&gt;        &quot;OMNI parameters:       &quot;&lt;br&gt;        + &quot;, &quot;.join(request[&quot;omni_parameters&quot;])&lt;br&gt;    )&lt;br&gt;    emit(f&quot;Planned samples:       {len(sample_plan)}&quot;)&lt;br&gt;    emit(f&quot;K-index input:         {request[&#39;kindex_path&#39;]}&quot;)&lt;br&gt;    emit(f&quot;OMNI input:            {request[&#39;omni_path&#39;]}&quot;)&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 2. K-index summary&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    print_frame(&lt;br&gt;        &quot;K-INDEX COVERAGE SUMMARY&quot;,&lt;br&gt;        kindex_report[&quot;summary&quot;],&lt;br&gt;    )&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 3. OMNI request-level overview&lt;br&gt;    #&lt;br&gt;    # These are requirement counts across forecast-origin/parameter&lt;br&gt;    # combinations. Overlapping lookback windows can represent the same&lt;br&gt;    # physical source minute more than once.&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    omni_overview = pd.DataFrame(&lt;br&gt;        [&lt;br&gt;            {&lt;br&gt;                &quot;forecast_origin_count&quot;: (&lt;br&gt;                    omni_summary[&quot;forecast_origin&quot;].nunique()&lt;br&gt;                ),&lt;br&gt;                &quot;parameter_count&quot;: (&lt;br&gt;                    omni_summary[&quot;parameter&quot;].nunique()&lt;br&gt;                ),&lt;br&gt;                &quot;parameter_window_count&quot;: len(omni_summary),&lt;br&gt;                &quot;expected_requirement_minutes&quot;: int(&lt;br&gt;                    omni_summary[&quot;expected_minute_count&quot;].sum()&lt;br&gt;                ),&lt;br&gt;                &quot;absent_requirement_minutes&quot;: int(&lt;br&gt;                    omni_summary[&quot;absent_minute_count&quot;].sum()&lt;br&gt;                ),&lt;br&gt;                &quot;source_fill_requirement_minutes&quot;: int(&lt;br&gt;                    omni_summary[&quot;source_fill_minute_count&quot;].sum()&lt;br&gt;                ),&lt;br&gt;                &quot;unexplained_null_requirement_minutes&quot;: int(&lt;br&gt;                    omni_summary[&lt;br&gt;                        &quot;unexplained_null_minute_count&quot;&lt;br&gt;                    ].sum()&lt;br&gt;                ),&lt;br&gt;                &quot;conflict_requirement_minutes&quot;: int(&lt;br&gt;                    omni_summary[&quot;conflict_minute_count&quot;].sum()&lt;br&gt;                ),&lt;br&gt;                &quot;reingestion_candidate_windows&quot;: int(&lt;br&gt;                    omni_summary[&lt;br&gt;                        &quot;is_reingestion_candidate&quot;&lt;br&gt;                    ].sum()&lt;br&gt;                ),&lt;br&gt;            }&lt;br&gt;        ]&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;OMNI COVERAGE OVERVIEW&quot;,&lt;br&gt;        omni_overview,&lt;br&gt;    )&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 4. Issue summary&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    issues_frame = pd.DataFrame(issues)&lt;br&gt;    if issues_frame.empty:&lt;br&gt;        issue_summary = pd.DataFrame()&lt;br&gt;    else:&lt;br&gt;        issue_summary = (&lt;br&gt;            issues_frame&lt;br&gt;            .groupby(&lt;br&gt;                [&quot;dataset&quot;, &quot;issue&quot;],&lt;br&gt;                dropna=False,&lt;br&gt;                as_index=False,&lt;br&gt;            )&lt;br&gt;            .agg(&lt;br&gt;                issue_record_count=(&quot;count&quot;, &quot;size&quot;),&lt;br&gt;                reported_count_total=(&quot;count&quot;, &quot;sum&quot;),&lt;br&gt;            )&lt;br&gt;        )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;ELIGIBILITY ISSUE SUMMARY&quot;,&lt;br&gt;        issue_summary,&lt;br&gt;    )&lt;br&gt;    if detail == &quot;summary&quot;:&lt;br&gt;        return&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 5. Issue-focused output&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    if detail == &quot;issues&quot;:&lt;br&gt;        print_frame(&lt;br&gt;            &quot;K-INDEX GAP INTERVALS&quot;,&lt;br&gt;            kindex_report[&quot;gap_intervals&quot;],&lt;br&gt;        )&lt;br&gt;        print_frame(&lt;br&gt;            &quot;K-INDEX CONFLICT INTERVALS&quot;,&lt;br&gt;            kindex_report[&quot;conflict_intervals&quot;],&lt;br&gt;        )&lt;br&gt;        problematic_omni = omni_summary.loc[&lt;br&gt;            (&lt;br&gt;                omni_summary[&quot;is_reingestion_candidate&quot;]&lt;br&gt;            )&lt;br&gt;            | (&lt;br&gt;                omni_summary[&lt;br&gt;                    &quot;unexplained_null_minute_count&quot;&lt;br&gt;                ] &amp;gt; 0&lt;br&gt;            )&lt;br&gt;            | (&lt;br&gt;                omni_summary[&quot;conflict_minute_count&quot;] &amp;gt; 0&lt;br&gt;            )&lt;br&gt;        ]&lt;br&gt;        print_frame(&lt;br&gt;            &quot;OMNI PROBLEMATIC PARAMETER WINDOWS&quot;,&lt;br&gt;            problematic_omni,&lt;br&gt;        )&lt;br&gt;        print_frame(&lt;br&gt;            &quot;ELIGIBILITY ISSUE RECORDS&quot;,&lt;br&gt;            _ordered_issue_columns(issues_frame),&lt;br&gt;        )&lt;br&gt;        return&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    # 6. Complete output&lt;br&gt;    # ---------------------------------------------------------------&lt;br&gt;    print_frame(&lt;br&gt;        &quot;SAMPLE PLAN&quot;,&lt;br&gt;        sample_plan,&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;K-INDEX COVERED INTERVALS&quot;,&lt;br&gt;        kindex_report[&quot;covered_intervals&quot;],&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;K-INDEX GAP INTERVALS&quot;,&lt;br&gt;        kindex_report[&quot;gap_intervals&quot;],&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;K-INDEX CONFLICT INTERVALS&quot;,&lt;br&gt;        kindex_report[&quot;conflict_intervals&quot;],&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;OMNI COVERAGE BY FORECAST ORIGIN AND PARAMETER&quot;,&lt;br&gt;        omni_summary,&lt;br&gt;    )&lt;br&gt;    print_frame(&lt;br&gt;        &quot;ELIGIBILITY ISSUE RECORDS&quot;,&lt;br&gt;        _ordered_issue_columns(issues_frame),&lt;br&gt;    )&lt;/code&gt;&lt;/pre&gt;" id="_z0JOxSN1zZp124sYB1b-8">
                    <mxCell style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                        <mxGeometry x="-1876" y="1375" width="591" height="4349" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="_z0JOxSN1zZp124sYB1b-9" style="edgeStyle=none;html=1;exitX=0.044;exitY=0.917;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.023;entryY=0.037;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="0_0V6qsEWYtUXTMsCOMM-7" target="_z0JOxSN1zZp124sYB1b-8">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="-1187" y="1516" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="0_0V6qsEWYtUXTMsCOMM-1" value="&lt;pre style=&quot;display: block; font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0px; tab-size: 4; white-space: pre-wrap; background-color: rgb(246, 248, 250); padding: 8px 0px 10px;&quot;&gt;&lt;code class=&quot;language-Python&quot;&gt;&lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;class&lt;/span&gt; DatasetRequest(TypedDict):&lt;br&gt;    kindex_path: str&lt;br&gt;    omni_path: str&lt;br&gt;    location: str&lt;br&gt;    start_utc: pd&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;Timestamp&lt;/span&gt;&lt;br&gt;    end_utc: pd&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;Timestamp&lt;/span&gt;&lt;br&gt;    omni_parameters: list[str]&lt;br&gt;    omni_lookback_minutes: int&lt;br&gt;    kindex_lag_count: int&lt;br&gt;&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="1">
                    <mxGeometry x="509" y="852" width="261" height="216" as="geometry"/>
                </mxCell>
                <mxCell id="_z0JOxSN1zZp124sYB1b-10" value="Artifacts to write to disk&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;pre style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 18.9px; color: rgb(36, 41, 47); margin: 0px; tab-size: 4; white-space: pre-wrap; background-color: rgb(246, 248, 250); padding: 8px 0px 10px;&quot;&gt;&lt;code&gt;assessment_id=&amp;lt;timestamp&amp;gt;/&lt;br&gt;    _manifest.json&lt;br&gt;    sample_plan.parquet&lt;br&gt;    issues.json&lt;br&gt;    kindex/&lt;br&gt;        summary.parquet&lt;br&gt;        covered_intervals.parquet&lt;br&gt;        gap_intervals.parquet&lt;br&gt;        conflict_intervals.parquet&lt;br&gt;    omni/&lt;br&gt;        summary.parquet&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="-633" y="-384" width="298" height="319" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
