n style=&quot;color: rgb(204, 204, 204);&quot;&gt;/&lt;/span&gt; &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;issues.json&quot;&lt;/span&gt;,&lt;br&gt;        )&lt;br&gt;        manifest &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;background-color: rgb(255, 255, 204);&quot;&gt;build_dataset_assessment_manifest&lt;/span&gt;(&lt;br&gt;            assessment&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;assessment,&lt;br&gt;            input_fingerprints&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;input_fingerprints,&lt;br&gt;            artifact_records&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;artifact_records,&lt;br&gt;            assessment_id&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;assessment_id,&lt;br&gt;            created_at_utc&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;created_at_utc,&lt;br&gt;        )&lt;br&gt;        &lt;span style=&quot;color: rgb(106, 115, 125); font-style: italic;&quot;&gt;# Write the manifest only after every referenced artifact exists.&lt;/span&gt;&lt;br&gt;        staging_manifest_path &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;background-color: rgb(255, 255, 204);&quot;&gt;write_dataset_assessment_manifest&lt;/span&gt;(&lt;br&gt;            manifest&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;manifest,&lt;br&gt;            manifest_path&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;staging_dir &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;/&lt;/span&gt; &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;_manifest.json&quot;&lt;/span&gt;,&lt;br&gt;        )&lt;br&gt;        &lt;span style=&quot;background-color: rgb(255, 255, 204);&quot;&gt;publish_staged_directory&lt;/span&gt;(&lt;br&gt;            staging_dir&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;staging_dir,&lt;br&gt;            output_dir&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;output_path,&lt;br&gt;        )&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;except&lt;/span&gt; Exception:&lt;br&gt;        &lt;span style=&quot;background-color: rgb(255, 255, 204);&quot;&gt;remove_staging_directory_if_present&lt;/span&gt;(staging_dir)&lt;br&gt;        &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;raise&lt;br&gt;&lt;/span&gt;&lt;br&gt;    &lt;span style=&quot;color: rgb(207, 34, 46);&quot;&gt;return&lt;/span&gt; {&lt;br&gt;        &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;output_dir&quot;&lt;/span&gt;: output_path,&lt;br&gt;        &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;manifest_path&quot;&lt;/span&gt;: output_path &lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;/&lt;/span&gt; staging_manifest_path&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;.&lt;/span&gt;&lt;span style=&quot;color: rgb(149, 56, 0);&quot;&gt;name&lt;/span&gt;,&lt;br&gt;        &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;artifact_paths&quot;&lt;/span&gt;: &lt;span style=&quot;background-color: rgb(255, 255, 204);&quot;&gt;resolve_published_artifact_paths&lt;/span&gt;(&lt;br&gt;            output_dir&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;output_path,&lt;br&gt;            artifact_records&lt;span style=&quot;color: rgb(204, 204, 204);&quot;&gt;=&lt;/span&gt;artifact_records,&lt;br&gt;        ),&lt;br&gt;    }&lt;/code&gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
