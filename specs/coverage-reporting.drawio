                <mxCell id="gWd4IwDMt4Clc4eWDpV_-2" value="0. Input:&lt;div&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;code dir=&quot;ltr&quot;&gt;start_utc&lt;/code&gt;&lt;/th&gt;&lt;th&gt;&lt;code dir=&quot;ltr&quot;&gt;end_utc&lt;/code&gt;&lt;/th&gt;&lt;th&gt;&lt;code dir=&quot;ltr&quot;&gt;location&lt;/code&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;2026-01-01 00:00&lt;/td&gt;&lt;td&gt;2026-01-02 00:00&lt;/td&gt;&lt;td&gt;Australian region&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
