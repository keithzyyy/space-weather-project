t;&gt;0&lt;/span&gt;&lt;br&gt;  },&lt;br&gt;  &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;artifacts&quot;&lt;/span&gt;: {&lt;br&gt;    &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;sample_plan&quot;&lt;/span&gt;: {&lt;br&gt;      &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;path&quot;&lt;/span&gt;: &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;sample_plan.parquet&quot;&lt;/span&gt;,&lt;br&gt;      &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;rows&quot;&lt;/span&gt;: &lt;span style=&quot;color: rgb(5, 80, 174);&quot;&gt;7&lt;/span&gt;&lt;br&gt;    },&lt;br&gt;    &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;omni_summary&quot;&lt;/span&gt;: {&lt;br&gt;      &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;path&quot;&lt;/span&gt;: &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;omni/summary.parquet&quot;&lt;/span&gt;,&lt;br&gt;      &lt;span style=&quot;color: rgb(10, 48, 105);&quot;&gt;&quot;rows&quot;&lt;/span&gt;: &lt;span style=&quot;color: rgb(5, 80, 174);&quot;&gt;14&lt;/span&gt;&lt;br&gt;    }&lt;br&gt;  },&lt;br&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;{&lt;br/&gt;  &quot;inputs&quot;: {&lt;br/&gt;    &quot;kindex&quot;: {&lt;br/&gt;      &quot;resolved_path&quot;: &quot;data/03-canonical/kindex/canonical.parquet&quot;,&lt;br/&gt;      &quot;files&quot;: [&lt;br/&gt;        {&lt;br/&gt;          &quot;relative_path&quot;: &quot;canonical.parquet&quot;,&lt;br/&gt;          &quot;size_bytes&quot;: 184392,&lt;br/&gt;          &quot;modified_time_ns&quot;: 1790747712345678900&lt;br/&gt;        }&lt;br/&gt;      ]&lt;br/&gt;    }&lt;br/&gt;  }&lt;br/&gt;}&lt;/code&gt;&lt;/pre&gt;}&lt;/code&gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="-559" y="2661" width="570" height="1008" as="geometry"/>
