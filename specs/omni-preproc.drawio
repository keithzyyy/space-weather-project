    <diagram id="omniRebuildFlow20" name="Rebuild flow 2.0">
        <mxGraphModel dx="1265" dy="1142" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1250" math="0" shadow="0">
            <root>
                <mxCell id="reb2-0"/>
