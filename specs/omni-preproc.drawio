                <mxCell id="reb2-title" value="OMNI long-observation audit: rebuild flow 2.0" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" parent="reb2-1" vertex="1">
                    <mxGeometry x="30" y="20" width="1000" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-subtitle" value="Rebuild the dedicated long audit from every eligible successful run. Red boxes are failure modes; non-success runs are valid skips." style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=middle;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="30" y="60" width="1400" height="30" as="geometry"/>
