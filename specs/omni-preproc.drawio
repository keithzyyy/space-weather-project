                <mxCell id="reb2-container-manifest" value="" style="rounded=0;whiteSpace=wrap;html=1;opacity=20;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" parent="reb2-1" vertex="1">
                    <mxGeometry x="20" y="110" width="2026" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-label-manifest" value="1. Dataset boundary and manifest eligibility" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" parent="reb2-1" vertex="1">
                    <mxGeometry x="40" y="115" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-raw-input" value="&lt;b&gt;Input: dataset-specific raw directory&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;lt;raw_output_dir&amp;gt;/&amp;lt;dataset_id&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="50" y="165" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-raw-check" value="&lt;b&gt;Validate local dataset boundary&lt;/b&gt;&lt;br&gt;&lt;br&gt;Directory exists&lt;br&gt;Expected dataset ID = directory leaf name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="330" y="155" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-discover" value="&lt;b&gt;Discover candidate manifests&lt;/b&gt;&lt;br&gt;&lt;br&gt;run_id=*/_manifest.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="620" y="165" width="210" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-identity" value="&lt;b&gt;Read JSON and validate run identity&lt;/b&gt;&lt;br&gt;&lt;br&gt;Top-level object&lt;br&gt;run_id + known status&lt;br&gt;created_at_utc and directory agree" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="880" y="145" width="250" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-status" value="Run status?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1180" y="155" width="150" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-skip" value="&lt;b&gt;RUNNING or FAILED&lt;/b&gt;&lt;br&gt;&lt;br&gt;Skip run. Do not require source or artifact keys/metadata." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1140" y="300" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-success-validate" value="&lt;b&gt;SUCCESS: validate eligible manifest&lt;/b&gt;&lt;br&gt;&lt;br&gt;source.dataset_id exists and matches directory leaf&lt;br&gt;artifacts is an object" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1400" y="145" width="280" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-success-paths" value="&lt;b&gt;All successful manifest paths&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validated and ordered by run ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1791" y="165" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-fail-raw" value="&lt;b&gt;Failure mode&lt;/b&gt;&lt;br&gt;Raw dataset directory is missing.&lt;br&gt;&lt;b&gt;Fail fast.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" parent="reb2-1" vertex="1">
                    <mxGeometry x="330" y="300" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-fail-identity" value="&lt;b&gt;Failure mode&lt;/b&gt;&lt;br&gt;Unreadable/non-object JSON, missing run identity, unknown status, or run ID disagreement.&lt;br&gt;&lt;b&gt;Eligibility is unknown: fail fast.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" parent="reb2-1" vertex="1">
                    <mxGeometry x="850" y="300" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-fail-success" value="&lt;b&gt;Failure mode&lt;/b&gt;&lt;br&gt;Successful manifest is ❓missing required metadata&amp;nbsp;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;❓&lt;/span&gt;&amp;nbsp;or its dataset ID disagrees with the raw directory.&lt;br&gt;&lt;b&gt;Fail fast.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1400" y="300" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-container-input" value="" style="rounded=0;whiteSpace=wrap;html=1;opacity=20;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" parent="reb2-1" vertex="1">
                    <mxGeometry x="8" y="477" width="2047" height="361" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-label-input" value="2. Select every successful run and its recorded chunks" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" parent="reb2-1" vertex="1">
                    <mxGeometry x="40" y="485" width="650" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-any-success" value="Any successful manifests?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;" parent="reb2-1" vertex="1">
                    <mxGeometry x="80" y="565" width="180" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-chunk-discover" value="&lt;b&gt;Discover recorded chunks across all successful manifests&lt;/b&gt;&lt;br&gt;&lt;br&gt;Do not glob unrelated failed/running chunks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="340" y="564" width="280" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-chunk-validate" value="&lt;b&gt;Validate raw artifacts&lt;/b&gt;&lt;br&gt;&lt;br&gt;Valid unique chunk filenames&lt;br&gt;Every recorded chunk still exists" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="690" y="545" width="250" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-query" value="&lt;b&gt;build_long_observation_select_sql&lt;/b&gt;&lt;br&gt;&lt;br&gt;Input: every successful manifest + all recorded chunks&lt;br&gt;See &lt;b&gt;Generic flow&lt;/b&gt; for CTE internals.&lt;br&gt;&lt;br&gt;Important contracts:&lt;br&gt;- Time is first; [2:] means non-time values/definitions&lt;br&gt;- observation and parameter lengths match&lt;br&gt;- successful run LEFT JOIN preserves one sentinel when no non-time values exist&lt;br&gt;- source fill values remain raw and are flagged" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=3;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1020" y="558" width="330" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-query-execute" value="&lt;b&gt;Execute complete query through DuckDB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Malformed chunk JSON, invalid Time position, positional mismatch, or cast error propagates." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1440" y="562" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-stage" value="&lt;b&gt;Stage complete rebuild&lt;/b&gt;&lt;br&gt;&lt;br&gt;Temporary sibling directory&lt;br&gt;Parquet PARTITION_BY(run_id)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1775" y="564" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-fail-none" value="&lt;b&gt;Failure mode&lt;/b&gt;&lt;br&gt;No successful manifests exist.&lt;br&gt;&lt;b&gt;Fail fast; do not replace audit.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" parent="reb2-1" vertex="1">
                    <mxGeometry x="50" y="730" width="240" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-fail-chunk" value="&lt;b&gt;Failure mode&lt;/b&gt;&lt;br&gt;Missing/duplicate/invalid recorded chunk path.&lt;br&gt;&lt;b&gt;Fail before DuckDB reads it.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" parent="reb2-1" vertex="1">
                    <mxGeometry x="690" y="728" width="250" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-fail-query" value="&lt;b&gt;Failure mode&lt;/b&gt;&lt;br&gt;Query or staged COPY fails.&lt;br&gt;&lt;b&gt;Existing audit remains unchanged; propagate.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1454" y="710" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-container-write" value="" style="rounded=0;whiteSpace=wrap;html=1;opacity=20;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" parent="reb2-1" vertex="1">
                    <mxGeometry x="12" y="871" width="2037" height="522" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-label-write" value="3. Replace the complete long audit only after staging succeeds" style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" parent="reb2-1" vertex="1">
                    <mxGeometry x="23" y="876" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-partitions" value="At least one staged run partition?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;" parent="reb2-1" vertex="1">
                    <mxGeometry x="90" y="950" width="190" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-output-exists" value="Existing audit present?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;" parent="reb2-1" vertex="1">
                    <mxGeometry x="390" y="991" width="170" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-backup" value="&lt;b&gt;Move existing audit to temporary backup&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keep previous rebuild available until replacement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="650" y="991" width="270" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-replace" value="&lt;b&gt;Move staged rebuild into final output path&lt;/b&gt;&lt;br&gt;&lt;br&gt;Filesystem replacement is staged but not transactionally atomic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=13;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1030" y="991" width="280" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-replace-ok" value="Replacement succeeded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1449" y="938" width="170" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-complete" value="&lt;b&gt;Rebuild complete&lt;/b&gt;&lt;br&gt;&lt;br&gt;Log run/chunk counts and output path&lt;br&gt;Return audit output path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=13;fontStyle=1;" parent="reb2-1" vertex="1">
