                </mxCell>
                <mxCell id="reb2-fail-partitions" value="&lt;b&gt;Failure mode&lt;/b&gt;&lt;br&gt;Staged query produced no run partitions.&lt;br&gt;&lt;b&gt;Fail before replacement.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" parent="reb2-1" vertex="1">
                    <mxGeometry x="55" y="1170" width="230" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-restore" value="&lt;b&gt;Replacement failure&lt;/b&gt;&lt;br&gt;&lt;br&gt;If backup exists and final output is absent, restore previous audit; then re-raise original failure." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" parent="reb2-1" vertex="1">
                    <mxGeometry x="1390" y="1102" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="reb2-residual" value="&lt;b&gt;Residual failure mode&lt;/b&gt;&lt;br&gt;Backup restoration can itself fail due to filesystem conditions.&lt;br&gt;&lt;b&gt;No success reported.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" parent="reb2-1" vertex="1">
