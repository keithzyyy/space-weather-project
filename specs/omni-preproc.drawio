                <mxCell id="reb2-e4" value="valid identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="reb2-1" source="reb2-identity" target="reb2-status" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
