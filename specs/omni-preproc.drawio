                    <mxGeometry x="120" y="110" width="250" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="w-chunk1" value="&lt;b&gt;c1: chunk_0000__0002.json&lt;/b&gt;&lt;div style=&quot;text-align:left;font-family:monospace;&quot;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;parameters&amp;quot;: [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;quot;name&amp;quot;:&amp;quot;Time&amp;quot;, &amp;quot;type&amp;quot;:&amp;quot;isotime&amp;quot;, &amp;quot;units&amp;quot;:&amp;quot;UTC&amp;quot;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;quot;name&amp;quot;:&amp;quot;F&amp;quot;, &amp;quot;type&amp;quot;:&amp;quot;double&amp;quot;, &amp;quot;units&amp;quot;:&amp;quot;nT&amp;quot;, &amp;quot;fill&amp;quot;:9999.99},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;quot;name&amp;quot;:&amp;quot;BX_GSE&amp;quot;, &amp;quot;type&amp;quot;:&amp;quot;double&amp;quot;, &amp;quot;units&amp;quot;:&amp;quot;nT&amp;quot;, &amp;quot;fill&amp;quot;:9999.99}&lt;br&gt;&amp;nbsp;&amp;nbsp;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;data&amp;quot;: [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[&amp;quot;2026-01-01T00:00:00.000Z&amp;quot;, 9.85, -1.39],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[&amp;quot;2026-01-01T00:01:00.000Z&amp;quot;, 9.77, 9999.99]&lt;br&gt;&amp;nbsp;&amp;nbsp;]&lt;br&gt;}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;fontSize=12;" parent="1" vertex="1">
