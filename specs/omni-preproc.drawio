                <mxCell id="reb2-e6" value="SUCCESS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="reb2-1" source="reb2-status" target="reb2-success-validate" edge="1">
